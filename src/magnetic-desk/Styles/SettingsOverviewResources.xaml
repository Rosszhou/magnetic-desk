<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <LinearGradientBrush x:Key="SettingsGlassBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#DAEAF4FF" Offset="0" />
                <GradientStop Color="#D8EAEAF6" Offset="0.5" />
                <GradientStop Color="#D6EEEAE8" Offset="1" />
            </LinearGradientBrush>
            <AcrylicBrush x:Key="SettingsGlassPaneBrush" TintColor="#EEF6FF" TintOpacity="0.32" TintLuminosityOpacity="0.82" FallbackColor="#E7EEF6" />
            <SolidColorBrush x:Key="SettingsGlassContentBrush" Color="#78FFFFFF" />
            <SolidColorBrush x:Key="SettingsGlassStrokeBrush" Color="#CAFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#86FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#AEFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <LinearGradientBrush x:Key="SettingsGlassBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#DC192B3A" Offset="0" />
                <GradientStop Color="#DC262635" Offset="0.55" />
                <GradientStop Color="#DC28292D" Offset="1" />
            </LinearGradientBrush>
            <AcrylicBrush x:Key="SettingsGlassPaneBrush" TintColor="#24303E" TintOpacity="0.42" TintLuminosityOpacity="0.68" FallbackColor="#242B35" />
            <SolidColorBrush x:Key="SettingsGlassContentBrush" Color="#66252A32" />
            <SolidColorBrush x:Key="SettingsGlassStrokeBrush" Color="#2CFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#30FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#30FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#30FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#6A353943" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#20FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SettingsGlassBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SettingsGlassPaneBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SettingsGlassContentBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SettingsGlassStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style TargetType="toolkit:SettingsCard">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>
    <Style TargetType="toolkit:SettingsExpander">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>

    <x:Double x:Key="SettingsControlMinWidth">176</x:Double>
    <x:Double x:Key="SettingsCardSpacing">10</x:Double>
    <x:Double x:Key="SettingsRowMinHeight">72</x:Double>
    <x:Double x:Key="SettingsHeaderIconTextSpacing">20</x:Double>
    <Thickness x:Key="SettingsRowPadding">18,14</Thickness>
    <CornerRadius x:Key="SettingsCardCornerRadius">16</CornerRadius>

    <Style x:Key="SectionPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="{StaticResource SettingsCardSpacing}" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="SettingsGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SettingsCardCornerRadius}" />
    </Style>

    <Style x:Key="SettingTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Retired with the hand-built drill-down rows (now native SettingsCards)
         but kept as the SettingsCopyAndHierarchyTests anchor: its presence
         pins the identity-spacing token while the usage-side assertions keep
         the scaffolding pattern from coming back. -->
    <Style x:Key="SettingCardIdentityGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="{StaticResource SettingsHeaderIconTextSpacing}" />
    </Style>

    <Style x:Key="SettingDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingDescriptionTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SettingsSubsectionHeaderStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="4,14,4,4" />
        <Setter Property="Spacing" Value="2" />
    </Style>

    <Style x:Key="SettingsSubsectionTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingTitleTextStyle}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- Destructive counterpart of ActionButtonStyle: same metrics, Fluent
         critical foreground on the default subtle button chrome (matches
         WidgetDangerActionStyle and the widget title-bar close button). -->
    <Style x:Key="DangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <!-- Accent counterpart of ActionButtonStyle: same metrics so paired
         accent+plain buttons in one row stay height-aligned. -->
    <Style x:Key="AccentActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="IconActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="AccentSwatchButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
</ResourceDictionary>
