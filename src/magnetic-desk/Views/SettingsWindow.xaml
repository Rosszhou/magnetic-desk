<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MagneticDesk.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media.Imaging"
    xmlns:controls="using:MagneticDesk.Controls"
    xmlns:sections="using:MagneticDesk.Views.SettingsSections"
    xmlns:viewModels="using:MagneticDesk.ViewModels"
    xmlns:fileStack="using:MagneticDesk.Features.FileStack"
    xmlns:backup="using:MagneticDesk.Features.Backup"
    xmlns:svc="using:MagneticDesk.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MagneticDesk Settings">

    <Grid
        x:Name="SettingsRoot"
        MinWidth="800"
        MinHeight="560"
        IsTabStop="True"
        Background="Transparent">
        <Grid.KeyboardAccelerators>
            <!-- Ctrl+F jumps to the settings search box; F6 cycles the three
                 focus regions (title bar / navigation pane / content). WinUI 3
                 desktop has no built-in F6/FocusScope cycling, so the rotation
                 lives in SettingsWindow.KeyboardNavigation.cs. -->
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="SearchFocusAccelerator_Invoked" />
            <KeyboardAccelerator Key="F6" Invoked="RegionCycleAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
                    <ResourceDictionary Source="ms-appx:///Styles/MagneticControlResources.xaml" />
                </ResourceDictionary.MergedDictionaries>
            <x:Double x:Key="NavigationViewCompactPaneLength">58</x:Double>
            <x:Double x:Key="NavigationViewItemOnLeftMinHeight">42</x:Double>
            <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">22</x:Double>
            <Thickness x:Key="NavigationViewItemOnLeftIconBoxMargin">0</Thickness>

            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="Transparent" />
            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
            <Thickness x:Key="NavigationViewContentMargin">12,0,0,0</Thickness>
            <CornerRadius x:Key="NavigationViewContentGridCornerRadius">12</CornerRadius>
            <Style TargetType="NavigationViewItem">
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Thickness x:Key="NavigationViewItemButtonMargin">8,3,8,3</Thickness>

            <!-- Shared settings-page metrics keep top-level and drill-down pages aligned. -->
            <controls:SettingsBoolToVisibilityConverter x:Key="SettingsBoolToVisibilityConverter" />
            <controls:SettingsColorStringConverter x:Key="SettingsColorStringConverter" />
            <x:Double x:Key="SettingsContentMaxWidth">980</x:Double>
            <x:Double x:Key="SettingsRowColumnSpacing">18</x:Double>

            <Style x:Key="BreadcrumbTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="SettingsNavImageIconStyle" TargetType="ImageIcon">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
            </Style>

            <Style x:Key="SettingRowStyle" TargetType="Grid">
                <Setter Property="Tag" Value="SettingRow" />
                <Setter Property="MinHeight" Value="{StaticResource SettingsRowMinHeight}" />
                <Setter Property="Padding" Value="{StaticResource SettingsRowPadding}" />
                <Setter Property="ColumnSpacing" Value="{StaticResource SettingsRowColumnSpacing}" />
                <Setter Property="RowSpacing" Value="8" />
            </Style>

            <Style x:Key="SettingTextPanelStyle" TargetType="StackPanel">
                <Setter Property="Spacing" Value="3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="16,0,0,0" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="Opacity" Value="0.72" />
            </Style>

            <Style x:Key="InlineMetricSliderStyle" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
                <Setter Property="Width" Value="220" />
                <Setter Property="MinWidth" Value="160" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsThumbToolTipEnabled" Value="False" />
            </Style>

            <Style x:Key="SliderSettingValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingValueTextStyle}">
                <Setter Property="MinWidth" Value="42" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CompactNumberBoxStyle" TargetType="NumberBox">
                <Setter Property="Width" Value="128" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CompactTextActionButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="54" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="{ThemeResource SettingsGlassBackgroundBrush}" IsHitTestVisible="False" />
        <Border Grid.Row="1" Width="224" HorizontalAlignment="Left" Margin="12,0,0,12"
                CornerRadius="12" Background="{ThemeResource SettingsGlassPaneBrush}"
                BorderBrush="{ThemeResource SettingsGlassStrokeBrush}" BorderThickness="1" IsHitTestVisible="False" />

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="Transparent">
            <StackPanel
                x:Name="TitleTextHost"
                Margin="26,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Image
                    Width="30"
                    Height="30"
                    VerticalAlignment="Center">
                    <Image.Source>
                        <media:SvgImageSource UriSource="ms-appx:///Assets/magnetic-desk.svg" />
                    </Image.Source>
                </Image>
<TextBlock
VerticalAlignment="Center"
FontSize="18"
FontWeight="SemiBold"
Text="magnetic-desk" />
</StackPanel>


        </Grid>

        <Border
            Grid.Row="0"
            Height="1"
            VerticalAlignment="Bottom"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            Opacity="0.18" />

        <NavigationView
            x:Name="SettingsNavigationView"
            Grid.Row="1"
            Margin="12,0,12,12"
            Background="Transparent"
            CompactPaneLength="58"
            IsBackButtonVisible="Visible"
            IsBackEnabled="True"
            IsPaneOpen="True"
            IsSettingsVisible="False"
            OpenPaneLength="224"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Left"
            BackRequested="SettingsNavigationView_BackRequested"
            SelectionChanged="SettingsNavigationView_SelectionChanged">
            <NavigationView.PaneHeader>
            <AutoSuggestBox svc:Localized.AutomationNameKey="Settings.Search.Placeholder"
                x:Name="SettingsSearchBox"
                MinWidth="0"
                MaxWidth="240"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                CornerRadius="8"
                Margin="12,10,12,20"
                QueryIcon="Find"
                QuerySubmitted="SettingsSearchBox_QuerySubmitted"
                TextChanged="SettingsSearchBox_TextChanged">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8,6" Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                MaxLines="1"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                            <!-- Collapses for the single-line "no results" sentinel,
                                 which carries no breadcrumb. -->
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                Text="{Binding Breadcrumb}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding HasBreadcrumb, Converter={StaticResource SettingsBoolToVisibilityConverter}}" />
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="MagneticLayoutNavItem" Tag="MagneticLayout" svc:Localized.Key="Design.Settings.Layout">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A9;" FontSize="17" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CapsuleModeNavItem" Tag="CapsuleMode" svc:Localized.Key="Design.Nav.Collapse">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A0;" FontSize="17" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="FileWidgetNavItem" Tag="AppearanceDetail" svc:Localized.Key="Design.Nav.Content">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" FontSize="17" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Interaction" svc:Localized.Key="Design.Nav.Shortcuts">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" FontSize="17" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="GeneralNavItem" Tag="General" svc:Localized.Key="Design.Nav.Startup">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" FontSize="17" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem
                    Tag="About"
                    svc:Localized.Key="Settings.Nav.About">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Visibility="{x:Bind ViewModel.UpdateReminderBadgeVisibility, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontSize="17" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid x:Name="SettingsContentRoot" Background="{ThemeResource SettingsGlassContentBrush}" CornerRadius="12" BorderBrush="{ThemeResource SettingsGlassStrokeBrush}" BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="SettingsBreadcrumbHost"
                    Grid.Row="0"
                    Padding="20,16,20,0"
                    Visibility="Collapsed">
                    <BreadcrumbBar
                        x:Name="SettingsBreadcrumbBar"
                        Width="{StaticResource SettingsContentMaxWidth}"
                        MaxWidth="{StaticResource SettingsContentMaxWidth}"
                        HorizontalAlignment="Center"
                        ItemClicked="SettingsBreadcrumbBar_ItemClicked"
                        Visibility="Collapsed">
                        <BreadcrumbBar.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Style="{StaticResource BreadcrumbTextStyle}"
                                    Opacity="{Binding Opacity}"
                                    Text="{Binding Title}" />
                            </DataTemplate>
                        </BreadcrumbBar.ItemTemplate>
                    </BreadcrumbBar>
                </Grid>

                <ScrollViewer
                    x:Name="PageScroller"
                    Grid.Row="1"
                    Padding="20,16,20,38"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        x:Name="ContentHost"
                        Width="{StaticResource SettingsContentMaxWidth}"
                        MaxWidth="{StaticResource SettingsContentMaxWidth}"
                        HorizontalAlignment="Center"
                        Spacing="16">
                <StackPanel.Resources>
                    <DataTemplate x:Key="MagneticLayoutSectionTemplate" x:DataType="viewModels:SettingsViewModel">
                        <sections:MagneticLayoutSettingsSection x:Name="MagneticLayoutSection" Visibility="Collapsed" NavigationRequested="SettingsSection_NavigationRequested" />
                    </DataTemplate>
                    <DataTemplate x:Key="AppearanceSectionTemplate" x:DataType="viewModels:SettingsViewModel">
                        <sections:AppearanceSettingsSection x:Name="AppearanceSection" Visibility="Collapsed" NavigationRequested="SettingsSection_NavigationRequested" />
                    </DataTemplate>

                    <DataTemplate x:Key="AppearanceDensitySettingsSectionTemplate" x:DataType="viewModels:SettingsViewModel">
                        <StackPanel
                    x:Name="AppearanceDensitySettingsSection"
                    Visibility="Collapsed"
                    Style="{StaticResource SectionPanelStyle}">
                    <StackPanel Margin="0,8,0,0" Spacing="4">
                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.Density.Description"
                            svc:Localized.HeaderKey="Settings.Density.Title">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8A5;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox svc:Localized.AutomationNameKey="Settings.Density.Title"
                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                ItemsSource="{Binding AvailableLayoutDensityOptions}"
                                controls:SettingsComboBox.Value="{Binding LayoutDensity, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                                <toolkit:SettingsCard
                                    HorizontalContentAlignment="Right"
                                    svc:Localized.DescriptionKey="Settings.Density.Scale.Description"
                                    svc:Localized.HeaderKey="Settings.Density.Scale.Title">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource SliderSettingValueTextStyle}" Text="{Binding LayoutDensityValueText}" />
                                        <Slider svc:Localized.AutomationNameKey="Settings.Density.Scale.Title"
                                            Maximum="1"
                                            Minimum="0"
                                            StepFrequency="0.02"
                                            Style="{StaticResource InlineMetricSliderStyle}"
                                            Value="{Binding LayoutDensityScale, Mode=TwoWay}"
                                            ManipulationMode="TranslateX"
                                            ManipulationStarted="AppearanceSlider_ManipulationStarted"
                                            ManipulationCompleted="AppearanceSlider_ManipulationCompleted"
                                            ValueChanged="AppearanceSlider_ValueChanged"
                                            PointerPressed="AppearanceSlider_PointerPressed"
                                            PointerReleased="AppearanceSlider_PointerReleased"
                                            LostFocus="AppearanceSlider_LostFocus" />
                                    </StackPanel>
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard HorizontalContentAlignment="Right" svc:Localized.DescriptionKey="Settings.TextSize.Description" svc:Localized.HeaderKey="Settings.TextSize.Title">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource SliderSettingValueTextStyle}" Text="{Binding TextSizeValueText}" />
                                        <Slider svc:Localized.AutomationNameKey="Settings.TextSize.Title"
                                            Maximum="16"
                                            Minimum="10"
                                            StepFrequency="0.5"
                                            Style="{StaticResource InlineMetricSliderStyle}"
                                            Value="{Binding TextSize, Mode=TwoWay}"
                                            ManipulationMode="TranslateX"
                                            ManipulationStarted="AppearanceSlider_ManipulationStarted"
                                            ManipulationCompleted="AppearanceSlider_ManipulationCompleted"
                                            ValueChanged="AppearanceSlider_ValueChanged"
                                            PointerPressed="AppearanceSlider_PointerPressed"
                                            PointerReleased="AppearanceSlider_PointerReleased"
                                            LostFocus="AppearanceSlider_LostFocus" />
                                    </StackPanel>
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard HorizontalContentAlignment="Right" svc:Localized.DescriptionKey="Settings.IconSize.Description" svc:Localized.HeaderKey="Settings.IconSize.Title">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource SliderSettingValueTextStyle}" Text="{Binding IconSizeValueText}" />
                                        <Slider svc:Localized.AutomationNameKey="Settings.IconSize.Title"
                                            Maximum="56"
                                            Minimum="24"
                                            StepFrequency="2"
                                            Style="{StaticResource InlineMetricSliderStyle}"
                                            Value="{Binding IconSize, Mode=TwoWay}"
                                            ManipulationMode="TranslateX"
                                            ManipulationStarted="AppearanceSlider_ManipulationStarted"
                                            ManipulationCompleted="AppearanceSlider_ManipulationCompleted"
                                            ValueChanged="AppearanceSlider_ValueChanged"
                                            PointerPressed="AppearanceSlider_PointerPressed"
                                            PointerReleased="AppearanceSlider_PointerReleased"
                                            LostFocus="AppearanceSlider_LostFocus" />
                                    </StackPanel>
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard HorizontalContentAlignment="Right" svc:Localized.DescriptionKey="Settings.HorizontalSpacing.Description" svc:Localized.HeaderKey="Settings.HorizontalSpacing.Title">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource SliderSettingValueTextStyle}" Text="{Binding HorizontalSpacingValueText}" />
                                        <Slider svc:Localized.AutomationNameKey="Settings.HorizontalSpacing.Title" Maximum="1" Minimum="0" StepFrequency="0.02" Style="{StaticResource InlineMetricSliderStyle}" Value="{Binding HorizontalSpacingScale, Mode=TwoWay}" ManipulationMode="TranslateX" ManipulationStarted="AppearanceSlider_ManipulationStarted" ManipulationCompleted="AppearanceSlider_ManipulationCompleted" ValueChanged="AppearanceSlider_ValueChanged" PointerPressed="AppearanceSlider_PointerPressed" PointerReleased="AppearanceSlider_PointerReleased" LostFocus="AppearanceSlider_LostFocus" />
                                    </StackPanel>
                                </toolkit:SettingsCard>

                                <toolkit:SettingsCard HorizontalContentAlignment="Right" svc:Localized.DescriptionKey="Settings.VerticalSpacing.Description" svc:Localized.HeaderKey="Settings.VerticalSpacing.Title">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource SliderSettingValueTextStyle}" Text="{Binding VerticalSpacingValueText}" />
                                        <Slider svc:Localized.AutomationNameKey="Settings.VerticalSpacing.Title" Maximum="1" Minimum="0" StepFrequency="0.02" Style="{StaticResource InlineMetricSliderStyle}" Value="{Binding VerticalSpacingScale, Mode=TwoWay}" ManipulationMode="TranslateX" ManipulationStarted="AppearanceSlider_ManipulationStarted" ManipulationCompleted="AppearanceSlider_ManipulationCompleted" ValueChanged="AppearanceSlider_ValueChanged" PointerPressed="AppearanceSlider_PointerPressed" PointerReleased="AppearanceSlider_PointerReleased" LostFocus="AppearanceSlider_LostFocus" />
                                    </StackPanel>
                                </toolkit:SettingsCard>
                    </StackPanel>
                </StackPanel>
                    </DataTemplate>


                    <DataTemplate x:Key="WidgetGroupsSectionTemplate" x:DataType="viewModels:SettingsViewModel">
                        <StackPanel
                    x:Name="WidgetGroupsSection"
                    Visibility="Collapsed"
                    Style="{StaticResource SectionPanelStyle}">
                    <StackPanel Spacing="4">
                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.WidgetGroupNavigation.Description"
                            svc:Localized.HeaderKey="Settings.WidgetGroupNavigation.Title">
                            <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetGroupNavigation.Title"
                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                ItemsSource="{Binding AvailableNavigationStyleOptions}"
                                controls:SettingsComboBox.Value="{Binding DefaultNavigationStyle, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.WidgetGroupTitle.Description"
                            svc:Localized.HeaderKey="Settings.WidgetGroupTitle.Title">
                            <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetGroupTitle.Title"
                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                ItemsSource="{Binding AvailableTitleDisplayModeOptions}"
                                controls:SettingsComboBox.Value="{Binding DefaultTitleDisplayMode, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.WidgetGroupSwitchAnimation.Description"
                            svc:Localized.HeaderKey="Settings.WidgetGroupSwitchAnimation.Title">
                            <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetGroupSwitchAnimation.Title"
                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                ItemsSource="{Binding AvailableSwitchAnimationOptions}"
                                controls:SettingsComboBox.Value="{Binding DefaultSwitchAnimationStyle, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.WidgetGroupWheel.Description"
                            svc:Localized.HeaderKey="Settings.WidgetGroupWheel.Title">
                            <ToggleSwitch svc:Localized.AutomationNameKey="Settings.WidgetGroupWheel.Title"
                                MinWidth="0"
                                OffContent=""
                                OnContent=""
                                IsOn="{Binding WheelSwitchEnabled, Mode=TwoWay}" />
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Right"
                            svc:Localized.DescriptionKey="Settings.WidgetGroupHover.Description"
                            svc:Localized.HeaderKey="Settings.WidgetGroupHover.Title">
                            <ToggleSwitch svc:Localized.AutomationNameKey="Settings.WidgetGroupHover.Title"
                                MinWidth="0"
                                OffContent=""
                                OnContent=""
                                IsOn="{Binding HoverSwitchEnabled, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                    </StackPanel>

                    <StackPanel Style="{StaticResource SettingsSubsectionHeaderStyle}">
                        <TextBlock Style="{StaticResource SettingsSubsectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" svc:Localized.Key="Settings.WidgetGroups.Existing.Title" />
                        <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" svc:Localized.Key="Settings.WidgetGroups.Existing.Description" />
                    </StackPanel>

                    <toolkit:SettingsCard
                        Visibility="{Binding ShowExistingGroupsEmpty, Converter={StaticResource SettingsBoolToVisibilityConverter}}"
                        svc:Localized.DescriptionKey="Settings.WidgetGroups.Existing.Empty.Description"
                        svc:Localized.HeaderKey="Settings.WidgetGroups.Existing.Empty.Title">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE73E;" />
                        </toolkit:SettingsCard.HeaderIcon>
                    </toolkit:SettingsCard>

                    <ItemsControl
                        ItemsSource="{Binding ExistingGroups}"
                        Visibility="{Binding HasExistingGroups, Converter={StaticResource SettingsBoolToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <toolkit:SettingsExpander
                                    Margin="0,0,0,4"
                                    Description="{Binding Summary}"
                                    Header="{Binding DisplayName}"
                                    IsExpanded="False">
                                    <toolkit:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE8A1;" />
                                    </toolkit:SettingsExpander.HeaderIcon>
                                    <toolkit:SettingsExpander.Items>
                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            svc:Localized.DescriptionKey="Settings.WidgetGroupNavigation.Description"
                                            svc:Localized.HeaderKey="Settings.WidgetGroupNavigation.Title">
                                            <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetGroupNavigation.Title"
                                                MinWidth="220"
                                                ItemsSource="{Binding NavigationOptions}"
                                                SelectionChanged="WidgetGroupNavigationComboBox_SelectionChanged"
                                                Tag="{Binding GroupId}"
                                                controls:SettingsComboBox.Value="{Binding NavigationStyle, Mode=OneWay}" />
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            svc:Localized.DescriptionKey="Settings.WidgetGroupTitle.Description"
                                            svc:Localized.HeaderKey="Settings.WidgetGroupTitle.Title">
                                            <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetGroupTitle.Title"
                                                MinWidth="220"
                                                ItemsSource="{Binding TitleOptions}"
                                                SelectionChanged="WidgetGroupTitleComboBox_SelectionChanged"
                                                Tag="{Binding GroupId}"
                                                controls:SettingsComboBox.Value="{Binding TitleDisplayMode, Mode=OneWay}" />
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            svc:Localized.DescriptionKey="Settings.WidgetGroups.GroupChrome.Description"
                                            svc:Localized.HeaderKey="Settings.WidgetGroups.GroupChrome.Title">
                                            <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetGroups.GroupChrome.Title"
                                                MinWidth="220"
                                                ItemsSource="{Binding ChromeOptions}"
                                                SelectionChanged="WidgetGroupChromeComboBox_SelectionChanged"
                                                Tag="{Binding GroupId}"
                                                controls:SettingsComboBox.Value="{Binding ChromeMode, Mode=OneWay}" />
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            svc:Localized.DescriptionKey="Settings.WidgetGroups.GroupDisplay.Description"
                                            svc:Localized.HeaderKey="Settings.WidgetGroups.GroupDisplay.Title">
                                            <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetGroups.GroupDisplay.Title"
                                                MinWidth="220"
                                                ItemsSource="{Binding CollapseOptions}"
                                                SelectionChanged="WidgetGroupCollapseComboBox_SelectionChanged"
                                                Tag="{Binding GroupId}"
                                                controls:SettingsComboBox.Value="{Binding CollapseBehavior, Mode=OneWay}" />
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            svc:Localized.DescriptionKey="Settings.WidgetGroupWheel.Description"
                                            svc:Localized.HeaderKey="Settings.WidgetGroupWheel.Title">
                                            <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetGroupWheel.Title"
                                                MinWidth="220"
                                                ItemsSource="{Binding WheelOptions}"
                                                SelectionChanged="WidgetGroupWheelComboBox_SelectionChanged"
                                                Tag="{Binding GroupId}"
                                                controls:SettingsComboBox.Value="{Binding WheelSetting, Mode=OneWay}" />
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            HorizontalContentAlignment="Right"
                                            svc:Localized.DescriptionKey="Settings.WidgetGroupHover.Description"
                                            svc:Localized.HeaderKey="Settings.WidgetGroupHover.Title">
                                            <ComboBox svc:Localized.AutomationNameKey="Settings.WidgetGroupHover.Title"
                                                MinWidth="220"
                                                ItemsSource="{Binding HoverOptions}"
                                                SelectionChanged="WidgetGroupHoverComboBox_SelectionChanged"
                                                Tag="{Binding GroupId}"
                                                controls:SettingsComboBox.Value="{Binding HoverSetting, Mode=OneWay}" />
                                        </toolkit:SettingsCard>

                                        <toolkit:SettingsCard
                                            ContentAlignment="Vertical"
                                            HorizontalContentAlignment="Stretch"
                                            svc:Localized.HeaderKey="Settings.WidgetGroups.Existing.Members.Title">
                                            <ItemsControl ItemsSource="{Binding Members}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid
                                                            MinHeight="38"
                                                            ColumnDefinitions="*,Auto"
                                                            ColumnSpacing="10">
