<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MagneticDesk.Views.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MagneticDesk.Controls"
    xmlns:svc="using:MagneticDesk.Services"
    Title="magnetic-desk">
    <Grid x:Name="RootGrid" Background="{ThemeResource MagneticWindowBrush}">
        <Grid.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ms-appx:///Styles/MagneticControlResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="60" /><RowDefinition Height="68" /><RowDefinition Height="*" /><RowDefinition Height="76" /></Grid.RowDefinitions>
        <Grid x:Name="TitleBarHost" Padding="24,0,130,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/magnetic-desk.svg" Width="30" Height="30" />
                <TextBlock Text="magnetic-desk" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Border Height="1" Background="{ThemeResource MagneticStrokeBrush}" VerticalAlignment="Bottom" Margin="-24,0,-130,0" />
        </Grid>
        <Grid Grid.Row="1" Margin="40,8" ColumnSpacing="16" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="64" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="64" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border x:Name="CreateStepHighlight" CornerRadius="20" Background="{ThemeResource MagneticSelectionBrush}" />
            <Button x:Name="CreateStepButton" Tag="0" Click="Step_Click" Background="Transparent" BorderThickness="0" Padding="18,10" svc:Localized.Key="Design.Intro.CreateStep" />
            <Border Grid.Column="1" Height="1" Background="{ThemeResource MagneticStrokeBrush}" VerticalAlignment="Center" />
            <Border x:Name="DockStepHighlight" Grid.Column="2" CornerRadius="20" Background="{ThemeResource MagneticSelectionBrush}" />
            <Button x:Name="DockStepButton" Grid.Column="2" Tag="1" Click="Step_Click" Background="Transparent" BorderThickness="0" Padding="18,10" svc:Localized.Key="Design.Intro.DockStep" />
            <Border Grid.Column="3" Height="1" Background="{ThemeResource MagneticStrokeBrush}" VerticalAlignment="Center" />
            <Border x:Name="StartStepHighlight" Grid.Column="4" CornerRadius="20" Background="{ThemeResource MagneticSelectionBrush}" />
            <Button x:Name="StartStepButton" Grid.Column="4" Tag="2" Click="Step_Click" Background="Transparent" BorderThickness="0" Padding="18,10" svc:Localized.Key="Design.Intro.StartStep" />
        </Grid>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <Grid x:Name="ContentGrid" Margin="36,24,36,28" ColumnSpacing="28" RowSpacing="20" SizeChanged="ContentGrid_SizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.38*" /><ColumnDefinition Width="0.62*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid x:Name="TextHost" VerticalAlignment="Center">
                    <StackPanel x:Name="Step1Panel" Spacing="22">
                        <TextBlock FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" svc:Localized.Key="Design.Intro.CreateTitle" />
                        <TextBlock FontSize="15" LineHeight="25" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" svc:Localized.Key="Design.Intro.CreateBody" />
                        <Button x:Name="CreateWidgetButton" Click="CreateWidget_Click" Style="{StaticResource MagneticActionStyle}" HorizontalAlignment="Left" svc:Localized.Key="Design.Intro.CreateAction" />
                        <TextBlock x:Name="CreateStatusText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource MagneticAccentBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="Step2Panel" Spacing="22" Visibility="Collapsed">
                        <TextBlock FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" svc:Localized.Key="Design.Intro.DockTitle" />
                        <TextBlock FontSize="15" LineHeight="25" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" svc:Localized.Key="Design.Intro.DockBody" />
                        <Border Background="{ThemeResource MagneticSelectionBrush}" Padding="12,9" CornerRadius="8" HorizontalAlignment="Left"><TextBlock Text="Ctrl + Z" FontWeight="SemiBold" Foreground="{ThemeResource MagneticAccentBrush}" /></Border>
                        <TextBlock FontSize="13" TextWrapping="Wrap" svc:Localized.Key="Design.Intro.Undo" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="Step3Panel" Spacing="22" Visibility="Collapsed">
                        <TextBlock FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" svc:Localized.Key="Design.Intro.StartTitle" />
                        <TextBlock FontSize="15" LineHeight="25" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" svc:Localized.Key="Design.Intro.StartBody" />
                        <Border Style="{StaticResource MagneticSurfaceStyle}" Padding="14">
                            <StackPanel Spacing="12">
                                <TextBlock svc:Localized.Key="Design.Intro.Summon" FontSize="13" />
                                <TextBlock x:Name="SummonShortcutText" FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Button Click="Settings_Click" HorizontalAlignment="Left" Style="{StaticResource MagneticActionStyle}" svc:Localized.Key="Design.Intro.Settings" />
                    </StackPanel>
                </Grid>
                <Border x:Name="PreviewHost" Grid.Column="1" Padding="18" Style="{StaticResource MagneticSurfaceStyle}" VerticalAlignment="Center">
                    <controls:MagneticLayoutPreview x:Name="LayoutPreview" />
                </Border>
            </Grid>
        </ScrollViewer>
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource MagneticStrokeBrush}" Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="SkipButton" Click="Skip_Click" Background="Transparent" BorderThickness="0" svc:Localized.Key="Design.Intro.Skip" />
                <Button x:Name="BackButton" Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource MagneticActionStyle}" Click="BackButton_Click" svc:Localized.Key="Design.Intro.Back" />
                <Button x:Name="NextButton" Grid.Column="3" MinWidth="112" CornerRadius="8" Style="{StaticResource AccentButtonStyle}" Click="NextButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
