    <Compile Include="../magnetic-desk.Tests/WidgetCoordinatedMoveCalculatorTests.cs" Link="WidgetCoordinatedMoveCalculatorTests.cs" />
    <Compile Include="../magnetic-desk.Tests/WidgetSnapCalculatorTests.cs" Link="WidgetSnapCalculatorTests.cs" />
    <Compile Include="../magnetic-desk.Tests/QuickCaptureSettingsCoordinatorTests.cs" Link="QuickCaptureSettingsCoordinatorTests.cs" />
    <Compile Include="../magnetic-desk.Tests/QuickCaptureClipboardServiceTests.cs" Link="QuickCaptureClipboardServiceTests.cs" />
    <Compile Include="../magnetic-desk.Tests/WidgetRegistryTests.cs" Link="WidgetRegistryTests.cs" />
    <Compile Include="../magnetic-desk.Tests/QuickCaptureSettingsEditorTests.cs" Link="QuickCaptureSettingsEditorTests.cs" />
    <Compile Include="../magnetic-desk.Tests/BackupRuntimeTests.cs" Link="BackupRuntimeTests.cs" />
    <Compile Include="../magnetic-desk.Tests/DataBackupSettingsPolicyTests.cs" Link="DataBackupSettingsPolicyTests.cs" />
    <Compile Include="../magnetic-desk.Tests/MagneticDeskDataBackupServiceTests.cs" Link="MagneticDeskDataBackupServiceTests.cs" />
    <Compile Include="../magnetic-desk.Tests/CompactPresentationRefreshTests.cs" Link="CompactPresentationRefreshTests.cs" />
