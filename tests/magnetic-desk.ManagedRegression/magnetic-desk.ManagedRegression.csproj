    <ProjectReference Include="../../src/magnetic-desk/magnetic-desk.csproj"
                      AdditionalProperties="MagneticDeskShellThumbnailProxy=false;WindowsAppSDKSelfContained=true" />
    <Compile Include="../magnetic-desk.Tests/WidgetMagnetic*Tests.cs" Link="WidgetMagnetic*Tests.cs" />
    <Compile Include="../magnetic-desk.Tests/LocalizationServiceLanguageTests.cs" Link="LocalizationServiceLanguageTests.cs" />
    <Compile Include="../magnetic-desk.Tests/LocalizationResourceContractTests.cs" Link="LocalizationResourceContractTests.cs" />
    <Compile Include="../magnetic-desk.Tests/MagneticDeskBrandAndDragTests.cs" Link="MagneticDeskBrandAndDragTests.cs" />
